{
  "mode": "merge",
  "LOGGED_IN_LOCATORS": [
    { "by": "id", "value": "pane-side" },
    { "by": "xpath", "value": "//div[@id=\"pane-side\"]" },
    { "by": "xpath", "value": "//div[@data-testid=\"chat-list\"]" },
    { "by": "xpath", "value": "//header[@data-testid=\"chatlist-header\"]" },
    { "by": "xpath", "value": "//div[@id=\"side\"]" }
  ],
  "SEARCH_BOX_LOCATORS": [
    { "by": "xpath", "value": "//div[@contenteditable=\"true\"][@data-tab=\"3\"]" },
    { "by": "xpath", "value": "//div[@role=\"textbox\" and @aria-label=\"Search input textbox\"]" },
    { "by": "xpath", "value": "//div[@contenteditable=\"true\" and @title=\"Search input textbox\"]" }
  ],
  "CHAT_INPUT_LOCATORS": [
    { "by": "xpath", "value": "//footer//div[@contenteditable=\"true\"][@role=\"textbox\"]" },
    { "by": "xpath", "value": "//div[@contenteditable=\"true\"][@data-tab=\"10\"]" },
    { "by": "xpath", "value": "//div[@contenteditable=\"true\" and contains(@class,\"copyable-text\")]" }
  ],
  "CAPTION_BOX_LOCATORS": [
    { "by": "xpath", "value": "//div[@contenteditable=\"true\"][@data-tab=\"10\"]" },
    { "by": "xpath", "value": "//div[@contenteditable=\"true\" and contains(@class,\"copyable-text\")]" },
    { "by": "xpath", "value": "//div[@contenteditable=\"true\" and @data-testid=\"media-caption-input-container\"]" }
  ],
  "SEND_BUTTON_LOCATORS": [
    { "by": "xpath", "value": "//span[@data-icon=\"send\"]" },
    { "by": "xpath", "value": "//span[@data-icon=\"send-light\"]" },
    { "by": "xpath", "value": "//span[contains(@data-icon,\"send\")]" },
    { "by": "xpath", "value": "//button[@data-testid=\"compose-btn-send\"]" },
    { "by": "xpath", "value": "//button[@aria-label=\"Send\"]" },
    { "by": "xpath", "value": "//div[@role=\"button\" and @aria-label=\"Send\"]" },
    { "by": "xpath", "value": "//div[@role=\"button\" and contains(@aria-label,\"Send\")]" },
    { "by": "xpath", "value": "//button[contains(@aria-label,\"Send\")]" },
    { "by": "xpath", "value": "//div[@role=\"dialog\"]//span[contains(@data-icon,\"send\")]" },
    { "by": "xpath", "value": "//div[@role=\"dialog\"]//button[contains(@aria-label,\"Send\")]" },
    { "by": "xpath", "value": "//div[@role=\"dialog\"]//div[@role=\"button\" and contains(@aria-label,\"Send\")]" }
  ],
  "ATTACH_BUTTON_LOCATORS": [
    { "by": "css", "value": "footer span[data-icon=\"attach-menu-plus\"]" },
    { "by": "xpath", "value": "//footer//span[@data-icon=\"attach-menu-plus\"]" },
    { "by": "css", "value": "footer span[data-icon*=\"clip\"]" },
    { "by": "xpath", "value": "//footer//span[@data-icon=\"clip\"]" },
    { "by": "xpath", "value": "//footer//span[@data-icon=\"clip-light\"]" },
    { "by": "xpath", "value": "//footer//div[@title=\"Attach\"]" },
    { "by": "xpath", "value": "//footer//div[@title=\"إرفاق\"]" },
    { "by": "xpath", "value": "//footer//*[@aria-label=\"Attach\"]" },
    { "by": "xpath", "value": "//footer//*[@aria-label=\"إرفاق\"]" }
  ],
  "FILE_INPUT_LOCATORS": [
    { "by": "xpath", "value": "//input[@type=\"file\" and @accept=\"*\"]" },
    { "by": "xpath", "value": "//input[@type=\"file\" and not(contains(@accept,\"image\")) and not(contains(@accept,\"video\"))]" }
  ],
  "PHOTO_VIDEO_INPUT_LOCATORS": [
    { "by": "xpath", "value": "//input[@type=\"file\" and contains(@accept,\"video/mp4\")]" },
    { "by": "xpath", "value": "//input[@type=\"file\" and contains(@accept,\"video/3gpp\")]" },
    { "by": "xpath", "value": "//input[@type=\"file\" and contains(@accept,\"video/quicktime\")]" }
  ],
  "STICKER_PANEL_LOCATORS": [
    { "by": "xpath", "value": "//span[@data-icon=\"sticker\"]" },
    { "by": "xpath", "value": "//span[@data-icon=\"sticker-add\"]" },
    { "by": "xpath", "value": "//span[@data-icon=\"wds-ic-sticker\"]" }
  ],
  "MEDIA_PREVIEW_LOCATORS": [
    { "by": "xpath", "value": "//div[@data-testid=\"media-viewer\"]" },
    { "by": "xpath", "value": "//div[@role=\"dialog\"]//img" },
    { "by": "xpath", "value": "//img[contains(@src,\"blob:\")]" }
  ],
  "INVALID_NUMBER_LOCATORS": [
    { "by": "xpath", "value": "//*[contains(text(),\"phone number shared via url is invalid\")]" },
    { "by": "xpath", "value": "//*[contains(text(),\"Phone number shared via url is invalid\")]" },
    { "by": "xpath", "value": "//*[contains(text(),\"Invalid phone number\")]" },
    { "by": "xpath", "value": "//*[contains(text(),\"غير صحيح\")]" },
    { "by": "xpath", "value": "//*[contains(text(),\"ليس لديه واتساب\")]" },
    { "by": "xpath", "value": "//*[contains(text(),\"ليس لديه WhatsApp\")]" }
  ]
}
