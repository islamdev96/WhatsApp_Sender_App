    <system:String x:Key="L_WarmerSub">Interactive chatbot tool to exchange random/smart messages between accounts to boost HWID reputation and prevent bans.</system:String>
    <system:String x:Key="L_WarmerPlaceholder">(Active simulation panel is ready to be linked with WhatsApp profiles)</system:String>

