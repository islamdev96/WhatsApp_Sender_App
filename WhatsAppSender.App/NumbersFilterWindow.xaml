<Window x:Class="WhatsAppSender.App.NumbersFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TabFilter}" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource L_FilterTitle}" Style="{DynamicResource TextBlockHeading}"/>
            <TextBlock Text="{DynamicResource L_FilterSub}" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="إجمالي الأرقام / Total" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="10,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="نشط / Active (WhatsApp)" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding ValidCount}" FontSize="22" FontWeight="Bold" Foreground="#25D366"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="10,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="غير نشط / Non-Active" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding InvalidCount}" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardPanel}" Margin="10,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="معلق / Pending" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold" Foreground="#FF9800"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ListView with GridView -->
        <ListView Grid.Row="2" ItemsSource="{Binding NumbersList}" SelectedItem="{Binding SelectedNumber}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="الرقم / Phone Number" DisplayMemberBinding="{Binding Phone}" Width="250"/>
                    <GridViewColumn Header="الحالة / Status" DisplayMemberBinding="{Binding Status}" Width="250"/>
                    <GridViewColumn Header="وقت الفحص / Time Checked" DisplayMemberBinding="{Binding CheckTime}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer Progress and Actions -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Progress bar -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                <ProgressBar Value="{Binding ProgressBarValue}" Height="12" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ProgressBarValue, StringFormat=اكتمل: {0:F0}%}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>

            <!-- Buttons Grid -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Import -->
                <Button Content="استيراد CSV / Import" Command="{Binding ImportFromCSVCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="12,8"/>
                <Button Content="إضافة رقم / Add Phone" Command="{Binding AddManualCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Padding="10,8"/>
                <Button Content="مسح الكل / Clear" Command="{Binding ClearListCommand}" Margin="0,0,12,0" Style="{StaticResource DangerButton}" Padding="10,8"/>

                <!-- Control checking -->
                <Button Content="بدء الفحص / Start" Command="{Binding StartFilterCommand}" Margin="0,0,8,0" Visibility="{Binding IsFilterNotRunning, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="15,8"/>
                <Button Content="إيقاف / Stop" Command="{Binding StopFilterCommand}" Margin="0,0,12,0" Visibility="{Binding IsFilterRunning, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource DangerButton}" Padding="15,8"/>

                <!-- Export drop-downs or buttons -->
                <Button Content="تصدير النشط / Valid" Command="{Binding ExportCommand}" CommandParameter="valid" Margin="0,0,8,0" Background="#2E7D32" Padding="12,8"/>
                <Button Content="تصدير غير النشط / Invalid" Command="{Binding ExportCommand}" CommandParameter="invalid" Margin="0,0,8,0" Style="{StaticResource DangerButton}" Padding="12,8"/>
                <Button Content="تصدير الكل / Export All" Command="{Binding ExportCommand}" CommandParameter="all" Style="{StaticResource SecondaryButton}" Padding="12,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
