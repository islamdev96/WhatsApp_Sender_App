<Window x:Class="WhatsAppSender.App.GMapsScraperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="سحب خرائط جوجل / Google Maps Scraper" Height="650" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Pane: Controls & Table -->
            <ColumnDefinition Width="420"/>
            <!-- Splitter -->
            <ColumnDefinition Width="Auto"/>
            <!-- Right Pane: Browser View -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- A. Left Panel -->
        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Sub -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="سحب جهات الاتصال من جوجل / Google Maps Scraper" Style="{DynamicResource TextBlockHeading}" FontSize="16"/>
                <TextBlock Text="البحث عن الشركات واستخراج أرقام هواتفها مباشرة من خرائط جوجل" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>

            <!-- Search Controls -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="كلمة البحث / Search Query" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" FontSize="11"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="الحد الأقصى للنتائج / Limit" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" FontSize="11"/>
                            <TextBox Text="{Binding LimitValue, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="بدء الاستخراج / Start" Command="{Binding StartScrapingCommand}" Margin="0,0,4,0" Height="36" Background="#10B981"/>
                        <Button Grid.Column="1" Content="إيقاف / Stop" Command="{Binding StopScrapingCommand}" Margin="4,0,0,0" Height="36" Style="{StaticResource DangerButton}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ListView Table of Results -->
            <ListView Grid.Row="2" ItemsSource="{Binding ScrapedList}" SelectedItem="{Binding SelectedBusiness}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="الاسم / Name" DisplayMemberBinding="{Binding Name}" Width="220"/>
                        <GridViewColumn Header="الهاتف / Phone" DisplayMemberBinding="{Binding Phone}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Status Indicator -->
            <Border Grid.Row="3" Background="{DynamicResource BrushPrimaryBackground}" Padding="10,6" Margin="0,10,0,10" CornerRadius="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="عدد الأرقام المستخرجة / Scraped Count: " Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding ScrapedCount}" Foreground="{DynamicResource BrushAccent}" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Import/Export buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="استيراد للمرسل / Import" Command="{Binding ImportToCampaignCommand}" Margin="0,0,4,0" Height="40" Background="#00A884"/>
                <Button Grid.Column="1" Content="تصدير ملف CSV / Export" Command="{Binding ExportScrapedCommand}" Margin="4,0,0,0" Height="40" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Grid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

        <!-- B. Right Browser Panel -->
        <wv2:WebView2 x:Name="gmapsWebView" Grid.Column="2"/>
    </Grid>
</Window>
