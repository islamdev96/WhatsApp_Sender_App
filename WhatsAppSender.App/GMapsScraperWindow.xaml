<Window x:Class="WhatsAppSender.App.GMapsScraperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_GMapsTitle}" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource L_GMapsTitle}" Style="{DynamicResource TextBlockHeading}"/>
            <TextBlock Text="{DynamicResource L_GMapsSub}" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource CardPanel}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,0,15"/>
                    <Button Content="{DynamicResource BtnStartScrape}" Height="40"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
