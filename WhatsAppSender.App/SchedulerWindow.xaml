<Window x:Class="WhatsAppSender.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_SchedulerTitle}" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L_SchedulerTitle}" Style="{DynamicResource TextBlockHeading}"/>

        <ListView Grid.Row="1" ItemsSource="{Binding ScheduledCampaigns}" SelectedItem="{Binding SelectedCampaign}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource ColSchedId}" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="{DynamicResource ColSchedCampaign}" DisplayMemberBinding="{Binding Name}" Width="180"/>
                    <GridViewColumn Header="{DynamicResource ColSchedTime}" DisplayMemberBinding="{Binding ScheduledTime}" Width="160"/>
                    <GridViewColumn Header="{DynamicResource ColSchedGroup}" DisplayMemberBinding="{Binding GroupName}" Width="140"/>
                    <GridViewColumn Header="{DynamicResource ColSchedMode}" DisplayMemberBinding="{Binding SendingMode}" Width="90"/>
                    <GridViewColumn Header="{DynamicResource ColSchedStatus}" DisplayMemberBinding="{Binding Status}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="{DynamicResource BtnRefreshScheduler}" Command="{Binding LoadScheduledCommand}" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource BtnCancelScheduled}" Command="{Binding CancelCampaignCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource BtnDeleteScheduledHistory}" Command="{Binding DeleteCampaignCommand}" Style="{StaticResource DangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
