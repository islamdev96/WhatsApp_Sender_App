<Window x:Class="WhatsAppSender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:WhatsAppSender.App"
        xmlns:vm="clr-namespace:WhatsAppSender.App.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" Height="800" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLanguage}" Value="En">
                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <!-- ── ACTIVATION SCREEN (Show if not activated) ── -->
        <Grid x:Name="ActivationGrid" Background="{DynamicResource BrushPrimaryBackground}" Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivated}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="450" Height="400" Style="{DynamicResource CardPanel}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="WhatsApp Sender Pro" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{DynamicResource L_ActivationTitle}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="{DynamicResource L_HWIDLabel}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Hwid, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,15" Background="{DynamicResource BrushPrimaryBackground}"/>

                    <TextBlock Text="{DynamicResource L_ActivationKeyLabel}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding ActivationError}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <Button Content="{DynamicResource BtnActivate}" Command="{Binding ActivateCommand}" Height="42"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── MAIN DASHBOARD SCREEN (Show if activated) ── -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivated}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <DockPanel>
                <!-- 1. Top Menu Bar -->
                <Menu DockPanel.Dock="Top">
                    <MenuItem Header="{DynamicResource MenuFile}">
                        <MenuItem Header="{DynamicResource MenuExit}" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource MenuSettings}">
                        <MenuItem Header="{DynamicResource BtnToggleLang}" Command="{Binding ToggleLanguageCommand}"/>
                        <MenuItem Header="{DynamicResource BtnToggleTheme}" Command="{Binding ToggleThemeCommand}"/>
                        <MenuItem Header="{DynamicResource BtnToggleBrowser}" Command="{Binding ToggleBrowserCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource MenuTools}">
                        <MenuItem Header="{DynamicResource TabCampaignsHistory}" Command="{Binding OpenCampaignsHistoryCommand}"/>
                        <MenuItem Header="{DynamicResource TabContacts}" Command="{Binding OpenContactsManagerCommand}"/>
                        <MenuItem Header="{DynamicResource TabTemplates}" Command="{Binding OpenTemplatesManagerCommand}"/>
                        <MenuItem Header="{DynamicResource TabScheduled}" Command="{Binding OpenSchedulerCommand}"/>
                        <MenuItem Header="{DynamicResource TabGMaps}" Command="{Binding OpenGMapsScraperCommand}"/>
                        <MenuItem Header="{DynamicResource TabFilter}" Command="{Binding OpenNumbersFilterCommand}"/>
                        <MenuItem Header="{DynamicResource TabWarmer}" Command="{Binding OpenWarmerCommand}"/>
                        <MenuItem Header="{DynamicResource TabWorkflows}" Command="{Binding OpenWorkflowsCommand}"/>
                        <MenuItem Header="{DynamicResource TabLogs}" Command="{Binding OpenLogsCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- 2. Modern Flat Toolbar Tray -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrushPanelBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Open WhatsApp Browser -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ToggleBrowserCommand}">
                            <StackPanel>
                                <TextBlock Text="🌐" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbOpenWhatsApp}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="30" Background="{DynamicResource BrushBorder}" Margin="6,0" VerticalAlignment="Center"/>
                        
                        <!-- New Campaign (Clears current numbers) -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MainTab.ClearListCommand}">
                            <StackPanel>
                                <TextBlock Text="➕" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbNewCampaign}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Campaigns History -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenCampaignsHistoryCommand}">
                            <StackPanel>
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbHistory}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Contacts manager -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenContactsManagerCommand}">
                            <StackPanel>
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbContacts}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Templates -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenTemplatesManagerCommand}">
                            <StackPanel>
                                <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbTemplates}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Scheduler -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSchedulerCommand}">
                            <StackPanel>
                                <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbScheduler}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="30" Background="{DynamicResource BrushBorder}" Margin="6,0" VerticalAlignment="Center"/>
                        
                        <!-- GMaps Scraper -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenGMapsScraperCommand}">
                            <StackPanel>
                                <TextBlock Text="🗺️" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbGMaps}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Numbers Filter -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenNumbersFilterCommand}">
                            <StackPanel>
                                <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbFilter}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Warmer -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenWarmerCommand}">
                            <StackPanel>
                                <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbWarmer}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Workflows -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenWorkflowsCommand}">
                            <StackPanel>
                                <TextBlock Text="⛓️" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbWorkflows}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- System Logs -->
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenLogsCommand}">
                            <StackPanel>
                                <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TbLogs}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- 3. Bottom Status Bar -->
                <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource BrushPanelBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Height="30" Padding="5,0">
                    <StatusBarItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource StatusConnection}" Foreground="{DynamicResource BrushTextSecondary}" Margin="5,0"/>
                            <!-- Connection state dot indicator -->
                            <Ellipse Width="10" Height="10" Margin="5,0" Fill="{Binding ConnectionStatusBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator Background="{DynamicResource BrushBorder}"/>
                    <StatusBarItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MainTab.StatusMessage}" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator Background="{DynamicResource BrushBorder}"/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource StatusLicense}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0"/>
                    </StatusBarItem>
                </StatusBar>

                <!-- 4. Central resizable Workspace (Grid) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left pane: 3-column sending board -->
                        <ColumnDefinition Width="*"/>
                        <!-- Splitter between dashboard and browser -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Right pane: Collapsible browser -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- A. Central Dashboard split into 3 columns -->
                    <Grid Grid.Column="0" Margin="10">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Left Column (Auto Reply + Received Inbox) -->
                            <ColumnDefinition Width="3*"/>
                            <!-- Splitter 1 -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Column 1: Center Column (WhatsApp target list) -->
                            <ColumnDefinition Width="3.5*"/>
                            <!-- Splitter 2 -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Column 2: Right Column (Message tab editor + Attachments + Sending controls) -->
                            <ColumnDefinition Width="3.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= COLUMN 0 (Left Column) ================= -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <!-- Auto reply chatbot rules -->
                                <RowDefinition Height="1*"/>
                                <!-- Splitter -->
                                <RowDefinition Height="Auto"/>
                                <!-- Inbox incoming messages -->
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- Auto Reply rules display -->
                            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,5" Padding="15">
                                <Grid DataContext="{Binding AutoReplyTab}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_AutoReplyTitle}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" Content="{DynamicResource L_EnableAutoReply}" IsChecked="{Binding AutoReplyEnabled}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding RulesList}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{DynamicResource ColRuleName}" DisplayMemberBinding="{Binding RuleName}" Width="90"/>
                                                <GridViewColumn Header="{DynamicResource ColKeywords}" DisplayMemberBinding="{Binding Keywords}" Width="110"/>
                                                <GridViewColumn Header="{DynamicResource ColRuleEnabled}" DisplayMemberBinding="{Binding Enabled}" Width="70"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Vertical splitter inside Left Column -->
                            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

                            <!-- Received Messages Log (Inbox) -->
                            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,5,0,0" Padding="15">
                                <Grid DataContext="{Binding ReceivedTab}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{DynamicResource L_InboxTitle}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ListView Grid.Row="1" ItemsSource="{Binding MessagesList}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{DynamicResource ColInboxDate}" DisplayMemberBinding="{Binding Date}" Width="90"/>
                                                <GridViewColumn Header="{DynamicResource ColInboxSender}" DisplayMemberBinding="{Binding Sender}" Width="90"/>
                                                <GridViewColumn Header="{DynamicResource ColInboxMessage}" DisplayMemberBinding="{Binding Message}" Width="120"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Splitter 1 -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

                        <!-- ================= COLUMN 1 (Center Column) ================= -->
                        <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="0" Padding="15" DataContext="{Binding MainTab}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{DynamicResource L_TargetListTitle}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Import Actions Toolbar -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{DynamicResource BtnImportCSV}" Command="{Binding ImportCSVCommand}" Style="{StaticResource SecondaryButton}" Padding="5,4" Margin="0,0,4,0" Height="32"/>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddManualCommand}" ToolTip="{DynamicResource TooltipAddManual}" Width="32" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Height="32"/>
                                    <Button Grid.Column="2" Content="-" Command="{Binding RemoveSelectedCommand}" ToolTip="{DynamicResource TooltipRemoveSelected}" Width="32" Style="{StaticResource DangerButton}" Margin="0,0,4,0" Height="32"/>
                                    <Button Grid.Column="3" Content="🗑️" Command="{Binding ClearListCommand}" ToolTip="{DynamicResource TooltipClearList}" Style="{StaticResource DangerButton}" Width="32" Height="32"/>
                                </Grid>

                                <!-- Target Groups Selection -->
                                <TextBlock Grid.Row="2" Text="{DynamicResource TabContacts}" Margin="0,0,0,4" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ComboBox Grid.Row="3" ItemsSource="{Binding SavedGroups}" SelectedItem="{Binding SelectedGroup}" HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,8"/>

                                <!-- Targets DataGrid -->
                                <ListView Grid.Row="4" ItemsSource="{Binding ContactsList}" SelectedItem="{Binding SelectedContact}" Height="300" Margin="0,0,0,10">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource ColName}" DisplayMemberBinding="{Binding Name}" Width="100"/>
                                            <GridViewColumn Header="{DynamicResource ColPhone}" DisplayMemberBinding="{Binding Phone}" Width="120"/>
                                            <GridViewColumn Header="{DynamicResource ColStatus}" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Counters Info -->
                                <Border Grid.Row="5" Background="{DynamicResource BrushPrimaryBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Total: " Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" Margin="0,0,15,0"/>
                                        
                                        <TextBlock Text="Contacts: " Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ContactsCount}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" Margin="0,0,15,0"/>

                                        <TextBlock Text="Groups: " Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GroupsCount}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="6" Value="{Binding ProgressBarValue}" Height="10"/>
                            </Grid>
                        </Border>

                        <!-- Splitter 2 -->
                        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

                        <!-- ================= COLUMN 2 (Right Column) ================= -->
                        <Grid Grid.Column="4" DataContext="{Binding MainTab}">
                            <Grid.RowDefinitions>
                                <!-- Message tab editor -->
                                <RowDefinition Height="6.5*"/>
                                <!-- Attachments -->
                                <RowDefinition Height="Auto"/>
                                <!-- Sending control triggers -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Message tab editor card -->
                            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Editor Header with "+" and "-" tab actions -->
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_MessageEditorTitle}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="+" Command="{Binding AddMessageTabCommand}" ToolTip="{DynamicResource TooltipAddTab}" Width="30" Height="26" Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,4,0"/>
                                            <Button Content="-" Command="{Binding RemoveMessageTabCommand}" ToolTip="{DynamicResource TooltipRemoveTab}" Width="30" Height="26" Style="{StaticResource DangerButton}" Padding="0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Message formatting toolbar -->
                                    <Grid Grid.Row="1" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button Content="B" Click="FormatText_Click" CommandParameter="*" ToolTip="Bold" Width="26" Height="26" Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,4,0" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Button Content="I" Click="FormatText_Click" CommandParameter="_" ToolTip="Italic" Width="26" Height="26" Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,4,0" FontFamily="Consolas" FontStyle="Italic"/>
                                            <Button Content="S" Click="FormatText_Click" CommandParameter="~" ToolTip="Strikethrough" Width="26" Height="26" Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,8,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <!-- Insert Variable Menu -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource ColName}" Click="InsertVar_Click" CommandParameter="{}{name}" Height="26" Padding="5,0" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                            <Button Content="Var1" Click="InsertVar_Click" CommandParameter="{}{var1}" Height="26" Padding="5,0" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                            <Button Content="Var2" Click="InsertVar_Click" CommandParameter="{}{var2}" Height="26" Padding="5,0" Style="{StaticResource SecondaryButton}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Multi message tab editor -->
                                    <TabControl Grid.Row="2" ItemsSource="{Binding MessageTabs}" SelectedItem="{Binding SelectedMessageTab}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Header}"/>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"/>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>

                                    <!-- Spintax preview toggle -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" FlowDirection="RightToLeft">
                                        <CheckBox Content="{DynamicResource L_EnableSpintax}" IsChecked="{Binding EnableSpintax}" Margin="0,0,15,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <Button Content="{DynamicResource BtnPreviewText}" Command="{Binding TestSpintaxCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Attachment panel -->
                            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_AttachmentsTitle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="📎" Command="{Binding BrowseAttachmentCommand}" ToolTip="{DynamicResource BtnSelectFile}" Style="{StaticResource SecondaryButton}" Width="32" Height="26" Padding="0" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="2" Text="≡" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{Binding AttachmentsList}" Height="80">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{DynamicResource ColName}" DisplayMemberBinding="{Binding FileName}" Width="150"/>
                                                <GridViewColumn Header="{DynamicResource ColStatus}" DisplayMemberBinding="{Binding Type}" Width="70"/>
                                                <GridViewColumn Header="Caption" DisplayMemberBinding="{Binding Caption}" Width="80"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Delays and Sending controls -->
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="{DynamicResource L_MinDelay}" Margin="0,0,0,4" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBox Text="{Binding MinDelay, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="{DynamicResource L_MaxDelay}" Margin="0,0,0,4" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBox Text="{Binding MaxDelay, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{DynamicResource BtnSendNow}" Command="{Binding StartCampaignCommand}" Height="44" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="{DynamicResource BtnPauseNow}" Command="{Binding StopCampaignCommand}" Style="{StaticResource DangerButton}" Height="44" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Splitter between central dashboard and WebView2 browser -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrowserVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>

                    <!-- B. Collapsible WebView2 Browser panel -->
                    <Border Grid.Column="2" Background="{DynamicResource BrushPanelBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="480"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrowserVisible}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BrushPrimaryBackground}" Padding="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{DynamicResource L_BrowserTitle}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- WebView2 instance -->
                            <wv2:WebView2 x:Name="webView" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
