<Window x:Class="WhatsAppSender.App.ContactsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_GroupsTitle}" Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Groups List -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource L_GroupsTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <ListView Grid.Row="1" ItemsSource="{Binding GroupsList}" SelectedItem="{Binding SelectedGroup}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource ColGroupName}" DisplayMemberBinding="{Binding Name}" Width="140"/>
                            <GridViewColumn Header="{DynamicResource ColCreated}" DisplayMemberBinding="{Binding Created}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource L_AddNewGroup}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="{DynamicResource BtnAdd}" Command="{Binding AddGroupCommand}" Height="34"/>
                    </Grid>
                    <Button Content="{DynamicResource BtnDeleteSelectedGroup}" Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Height="34"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Group details -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource L_GroupContacts}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text=" "/>
                    <TextBlock Text="{Binding SelectedGroup.Name}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding SelectedGroup.Contacts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource ColContactName}" DisplayMemberBinding="{Binding Name}" Width="160"/>
                            <GridViewColumn Header="{DynamicResource ColContactPhone}" DisplayMemberBinding="{Binding Phone}" Width="200"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Add Contact Form -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource L_AddContactToGroup}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewContactName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" Height="34"/>
                        <TextBox Grid.Column="1" Text="{Binding NewContactPhone, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0" Height="34"/>
                        <Button Grid.Column="2" Content="{DynamicResource BtnSaveContact}" Command="{Binding AddContactCommand}" Height="34"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
