<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="ColorPrimaryBackground">#F8FAFC</Color>
    <Color x:Key="ColorPanelBackground">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#64748B</Color>
    <Color x:Key="ColorAccent">#10B981</Color>
    <Color x:Key="ColorAccentHover">#059669</Color>
    <Color x:Key="ColorAccentPressed">#047857</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrimaryBackground" Color="{StaticResource ColorPrimaryBackground}"/>
    <SolidColorBrush x:Key="BrushPanelBackground" Color="{StaticResource ColorPanelBackground}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}"/>
    
    <!-- Input Fields -->
    <SolidColorBrush x:Key="BrushInputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushInputText" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#CBD5E1"/>
    
    <!-- Lists and Grids -->
    <SolidColorBrush x:Key="BrushListSelectedBackground" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushListHoverBackground" Color="#F1F5F9"/>
</ResourceDictionary>
