<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="ColorPrimaryBackground">#0F172A</Color>
    <Color x:Key="ColorPanelBackground">#1E293B</Color>
    <Color x:Key="ColorBorder">#334155</Color>
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorAccent">#00E676</Color>
    <Color x:Key="ColorAccentHover">#00C853</Color>
    <Color x:Key="ColorAccentPressed">#00B0FF</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrimaryBackground" Color="{StaticResource ColorPrimaryBackground}"/>
    <SolidColorBrush x:Key="BrushPanelBackground" Color="{StaticResource ColorPanelBackground}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}"/>
    
    <!-- Input Fields -->
    <SolidColorBrush x:Key="BrushInputBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushInputText" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#475569"/>
    
    <!-- Lists and Grids -->
    <SolidColorBrush x:Key="BrushListSelectedBackground" Color="#334155"/>
    <SolidColorBrush x:Key="BrushListHoverBackground" Color="#1E293B"/>
</ResourceDictionary>
