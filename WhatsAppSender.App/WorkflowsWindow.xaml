<Window x:Class="WhatsAppSender.App.WorkflowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_WorkflowsTitle}" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource L_WorkflowsTitle}" Style="{DynamicResource TextBlockHeading}"/>
            <TextBlock Text="{DynamicResource L_WorkflowsSub}" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource CardPanel}" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource L_WorkflowsPlaceholder}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="10"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
