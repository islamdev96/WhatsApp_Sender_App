<Window x:Class="WhatsAppSender.App.WorkflowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مسارات العمل وجدولة الإرسال بالتتابع / Drip Workflows" Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="منشئ مسارات العمل الآلية / Drip Campaign Workflows" Style="{DynamicResource TextBlockHeading}" FontSize="16"/>
            <TextBlock Text="تصميم مسارات رسائل متعددة الخطوات بجدولة زمنية وتأخيرات مخصصة لكل خطوة" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>

        <!-- Body split in 2 columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Saved Workflows List -->
                <ColumnDefinition Width="280"/>
                <!-- Splitter -->
                <ColumnDefinition Width="Auto"/>
                <!-- Right Pane: Workflow Editor -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- A. Left Panel -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="مسارات العمل المحفوظة / Saved" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding WorkflowsList}" SelectedItem="{Binding SelectedWorkflow}" DisplayMemberPath="Name" Background="{DynamicResource BrushInputBackground}" Foreground="{DynamicResource BrushInputText}" BorderBrush="{DynamicResource BrushInputBorder}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="جديد / New" Command="{Binding NewWorkflowCommand}" Margin="0,0,4,0" Height="36" Style="{StaticResource SecondaryButton}"/>
                    <Button Grid.Column="1" Content="حذف / Delete" Command="{Binding DeleteWorkflowCommand}" Margin="4,0,0,0" Height="36" Style="{StaticResource DangerButton}"/>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

            <!-- B. Right Panel (Editor) -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="15" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Workflow Name -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="اسم مسار العمل / Workflow Name" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="تحميل / Load" Command="{Binding LoadSelectedWorkflowCommand}" Height="34" Style="{StaticResource SecondaryButton}" Padding="12,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Steps Title -->
                    <TextBlock Grid.Row="1" Text="خطوات التتابع / Campaign Steps Sequence" FontWeight="Bold" Margin="0,5,0,5"/>

                    <!-- Steps ListView table -->
                    <ListView Grid.Row="2" ItemsSource="{Binding StepsList}" SelectedItem="{Binding SelectedStep}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="40"/>
                                <GridViewColumn Header="النوع / Type" DisplayMemberBinding="{Binding Type}" Width="100"/>
                                <GridViewColumn Header="المحتوى / Content" DisplayMemberBinding="{Binding Content}" Width="350"/>
                                <GridViewColumn Header="التأخير / Delay" DisplayMemberBinding="{Binding Delay}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Step Controls -->
                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="إضافة خطوة / Add Step" Command="{Binding AddStepCommand}" Height="38" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="حذف خطوة / Delete Step" Command="{Binding DeleteStepCommand}" Height="38" Padding="12,0" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="حفظ المسار / Save Workflow" Command="{Binding SaveWorkflowCommand}" Height="38" Padding="15,0" Background="#10B981"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
