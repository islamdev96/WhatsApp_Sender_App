<Window x:Class="WhatsAppSender.App.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_LogsTitle}" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource L_LogsTitle}" Style="{DynamicResource TextBlockHeading}"/>

        <ListView Grid.Row="1" ItemsSource="{Binding LogsList}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource ColLogTime}" DisplayMemberBinding="{Binding Time}" Width="100"/>
                    <GridViewColumn Header="{DynamicResource ColLogLevel}" DisplayMemberBinding="{Binding Level}" Width="100"/>
                    <GridViewColumn Header="{DynamicResource ColLogMessage}" DisplayMemberBinding="{Binding Message}" Width="580"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="{DynamicResource BtnClearLogs}" Command="{Binding ClearLogsCommand}" Style="{StaticResource DangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
