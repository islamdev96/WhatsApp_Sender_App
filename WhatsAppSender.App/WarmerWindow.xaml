<Window x:Class="WhatsAppSender.App.WarmerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تهيئة وتنشيط الحسابات / Account Warmer" Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushPrimaryBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="تهيئة وتنشيط الحساب / WhatsApp Account Warmer" Style="{DynamicResource TextBlockHeading}" FontSize="16"/>
            <TextBlock Text="تنشيط حسابات واتساب الجديدة عبر إرسال محادثات عشوائية ذكية إلى جهات اتصال ودية لمنع الحظر" Style="{DynamicResource TextBlockSubheading}" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>

        <!-- Body split in 2 columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Contacts & Messages -->
                <ColumnDefinition Width="1*"/>
                <!-- Splitter -->
                <ColumnDefinition Width="Auto"/>
                <!-- Right Pane: Settings & Log -->
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- A. Left Pane -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <!-- Friendly Contacts Section -->
                    <RowDefinition Height="1*"/>
                    <!-- Message Templates Section -->
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 1. Contacts -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="أرقام وهواتف الأصدقاء / Friendly Contacts" FontWeight="Bold" Margin="0,0,0,5"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewContactPhone, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="إضافة / Add" Command="{Binding AddContactCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="8,0" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" Content="حذف / Delete" Command="{Binding DeleteContactCommand}" Style="{StaticResource DangerButton}" Height="32" Padding="8,0"/>
                        </Grid>

                        <ListBox Grid.Row="2" ItemsSource="{Binding FriendlyContacts}" SelectedItem="{Binding SelectedContact}" Background="{DynamicResource BrushInputBackground}" Foreground="{DynamicResource BrushInputText}" BorderBrush="{DynamicResource BrushInputBorder}"/>
                    </Grid>
                </Border>

                <!-- 2. Messages -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="15" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="قوالب رسائل التهيئة / Message Templates" FontWeight="Bold" Margin="0,0,0,5"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewMsgTemplate, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="إضافة / Add" Command="{Binding AddMessageCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="8,0" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" Content="حذف / Delete" Command="{Binding DeleteMessageCommand}" Style="{StaticResource DangerButton}" Height="32" Padding="8,0"/>
                        </Grid>

                        <ListBox Grid.Row="2" ItemsSource="{Binding MsgTemplates}" SelectedItem="{Binding SelectedMsg}" Background="{DynamicResource BrushInputBackground}" Foreground="{DynamicResource BrushInputText}" BorderBrush="{DynamicResource BrushInputBorder}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BrushBorder}"/>

            <!-- B. Right Pane -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="15" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="إعدادات التهيئة / Settings" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Delay & Limits -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="الفترة الفاصلة بالدقائق / Interval" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" FontSize="11"/>
                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="الحد الأقصى اليومي للرسائل / Limit" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" FontSize="11"/>
                            <TextBox Text="{Binding DailyLimit, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="سجل المحادثات النشط / Session Log" FontWeight="Bold" Margin="0,8,0,5"/>

                    <!-- Realtime logs textbox -->
                    <TextBox Grid.Row="3" Text="{Binding WarmerLogText}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#141414" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="12" Margin="0,0,0,15" VerticalContentAlignment="Top"/>

                    <!-- Action buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="المرسلة / Sent: " Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChatsCount}" Foreground="{DynamicResource BrushAccent}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Start / Stop -->
                            <Button Content="بدء التهيئة / Start" Command="{Binding StartWarmerCommand}" Height="40" Padding="15,0" Margin="0,0,8,0" Background="#10B981" Visibility="{Binding IsWarmNotRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="إيقاف / Stop" Command="{Binding StopWarmerCommand}" Height="40" Padding="15,0" Style="{StaticResource DangerButton}" Visibility="{Binding IsWarmRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
